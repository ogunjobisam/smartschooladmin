# Supabase project settings — copy this file to .env and fill in your own values.
# All three are client-side values; access control is enforced by row-level
# security, not by these keys. Never put the service role key in this file.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
